# העתיקו לקובץ .env.local (מקומית) ולהגדרות הפרויקט ב-Vercel. לא להכניס ערכים אמיתיים לגיט.

# Supabase: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# מפתח סודי, רק בשרת (Cron, דואר יוצא, סקריפט נתוני דמו)
SUPABASE_SECRET_KEY=sb_secret_xxx

# כתובת האתר (לקישורים במיילים)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# סוכן ה-AI (Anthropic). בלי מפתח, העוזר מציג הודעה שהוא לא מוגדר
ANTHROPIC_API_KEY=

# מיילים דרך Resend (לא חובה). בלי מפתח, המיילים נשמרים בדואר היוצא בלבד
RESEND_API_KEY=
EMAIL_FROM=Kesem Bagilboa <onboarding@resend.dev>
# להדגמה: כל המיילים יישלחו לכתובת הזו במקום לנמען האמיתי
DEMO_EMAIL_OVERRIDE=

# Vercel שולח את הערך הזה בכותרת Authorization לנתיבי ה-Cron
CRON_SECRET=change-me
